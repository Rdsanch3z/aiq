# ASK — variáveis adicionais, específicas da adaptação do blueprint.
#
# Este arquivo NÃO é lido diretamente pelo Docker Compose — é um
# apêndice. Depois de criar deploy/.env a partir de deploy/.env.example
# (passo 2 da instalação), copie o conteúdo abaixo para dentro dele e
# preencha os valores.
#
# Por que um arquivo separado em vez de editar deploy/.env.example direto:
# mantém o upstream intacto, sem risco de conflito numa atualização futura
# do blueprint original.

# -----------------------------------------------------------------------
# Modelo — gateway LiteLLM (deploy/ask/litellm.yaml)
# -----------------------------------------------------------------------
# Endpoint interno do LiteLLM, falado pelo AI-Q (configs/config_ask.yml).
# Não precisa mudar em instalação padrão — é a rede interna do Docker.
AIQ_MODEL_ENDPOINT=http://litellm:4000
# Mesmo valor de LITELLM_MASTER_KEY abaixo.
AIQ_MODEL_API_KEY=

# Credenciais reais do Azure AI Foundry — usadas pelo LiteLLM, não pelo
# AI-Q diretamente (o AI-Q só conhece o LiteLLM).
AZURE_OPENAI_ENDPOINT=https://<seu-recurso>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2026-01-01-preview

# Chave mestra do LiteLLM — gere um valor aleatório forte (ex.: openssl
# rand -hex 24) e copie o MESMO valor para AIQ_MODEL_API_KEY acima.
LITELLM_MASTER_KEY=

# -----------------------------------------------------------------------
# Embeddings — dimensão do modelo escolhido no Azure (confirmar na Fase 0;
# mudar depois exige reindexar tudo)
# -----------------------------------------------------------------------
AIQ_EMBED_DIM=1536

# -----------------------------------------------------------------------
# Conhecido: o adapter OpenSearch do AI-Q só lê NVIDIA_API_KEY para
# autenticar a chamada de embeddings — mesmo apontando embed_base_url
# para outro serviço (ver sources/knowledge_layer/src/opensearch/adapter.py,
# _resolve_embedding_api_key). Enquanto isso não é corrigido no código,
# use este workaround: defina NVIDIA_API_KEY com o MESMO valor de
# LITELLM_MASTER_KEY. Feio, mas funciona — não deixe sem essa variável.
# -----------------------------------------------------------------------
NVIDIA_API_KEY=

# -----------------------------------------------------------------------
# Domínio público (Caddy) — "localhost" gera certificado local com aviso
# no navegador; um domínio real emite HTTPS de verdade automaticamente.
# -----------------------------------------------------------------------
ASK_DOMAIN=localhost

# -----------------------------------------------------------------------
# Camada de conhecimento (OpenSearch) — os defaults do compose já
# resolvem isso; só mude se for rodar fora do Docker Compose padrão.
# -----------------------------------------------------------------------
# OPENSEARCH_URL=http://opensearch:9200
# OPENSEARCH_INDEX_PREFIX=ask
# COLLECTION_NAME=ask_default
